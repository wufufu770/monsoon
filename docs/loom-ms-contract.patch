+    def register_external_effect(self, claim: Claim, call_id: str, request: dict) -> dict:
+        """ms 执行器的意图登记（方案 v2.5 步骤三，v3 契约）：调用方提供 call_id，
+        (tenant, call_id) 幂等——重复登记返回已有记录，不报错、不覆盖。
+        复用 _begin_effect 的 claim 校验与 tool.intent 事件路径。"""
+        if not call_id:
+            raise InvalidInput("call_id required")
+        with self.transaction() as db:
+            self._assert_claim(db, claim)
+            old = db.execute("SELECT * FROM effects WHERE tenant=? AND id=?",
+                             (claim.tenant_id, call_id)).fetchone()
+            if old:
+                if old["request_hash"] != digest(request) or old["run_id"] != claim.run_id:
+                    raise Conflict("call_id reused with different request")
+                return {"call_id": call_id, "status": "registered", "state": old["state"], "created": False}
+            db.execute("INSERT INTO effects VALUES (?,?,?,?,?,?,?,?)",
+                       (claim.tenant_id, call_id, claim.run_id, claim.task_id, claim.epoch,
+                        digest(request), "intent", None))
+            result = {"call_id": call_id, "task_id": claim.task_id, "status": "registered",
+                      "state": "intent", "created": True}
+            self._event(db, claim.tenant_id, claim.run_id, "tool.intent",
+                        {"call_id": call_id, "task_id": claim.task_id}, "gateway")
+            return result
+
     def _begin_effect(self, db, claim: Claim, operation_id: str, request: dict) -> dict:
         if not operation_id:
             raise InvalidInput("stable operation ID required")
