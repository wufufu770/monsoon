+    def events_page(self, tenant: str, run_id: str, *, after_seq: int = 0, limit: int = 100) -> dict:
+        """Cursor pagination for external workers (ms). The cursor is consumer-owned:
+        each worker holds its own after_seq; there is no shared cursor."""
+        if after_seq < 0:
+            raise InvalidInput("after_seq must be >= 0")
+        if limit < 1 or limit > 500:
+            raise InvalidInput("limit must be between 1 and 500")
+        with self.connect() as db:
+            self._run(db, tenant, run_id)
+            rows = db.execute(
+                "SELECT seq,envelope,hash FROM events WHERE tenant=? AND run_id=? AND seq>? ORDER BY seq LIMIT ?",
+                (tenant, run_id, after_seq, limit)).fetchall()
+            events = [{**json.loads(r["envelope"]), "hash": r["hash"]} for r in rows]
+            next_seq = events[-1]["seq"] if events else after_seq
+            return {"events": events, "next_seq": next_seq}
